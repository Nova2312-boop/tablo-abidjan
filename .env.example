# Copie ce fichier en .env et adapte les valeurs.
# Connexion PostgreSQL : postgres://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE
DATABASE_URL=postgres://postgres:MOT_DE_PASSE@localhost:5432/tablo

PORT=3000

# 1 = le code SMS s'affiche à l'écran (démo, aucun SMS envoyé). 0 = production (brancher un fournisseur SMS).
DEMO_OTP=1

# Compte administrateur créé au premier démarrage (base vide)
ADMIN_EMAIL=admin@tablo.ci
ADMIN_PASSWORD=Tablo2026!

# --- Envois réels ---
# SMS via LeTexto (letexto.com) : nom d'expéditeur de 11 caractères max, validé chez LeTexto
SMS_PROVIDER=letexto
LETEXTO_API_KEY=
LETEXTO_SENDER_NAME=TABLO
# E-mails via Resend (resend.com) : l'adresse doit appartenir à un domaine vérifié dans Resend
RESEND_API_KEY=
EMAIL_EXPEDITEUR="Tablô <noreply@ton-domaine.com>"

# Adresse publique du site, utilisée dans les liens envoyés par e-mail (ex. https://tablo.ci)
# PUBLIC_URL=
